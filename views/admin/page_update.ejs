                                                                    <label for="inputWysiwyg" class="col-sm-2 col-form-label"><%= entry.fields_name %></label>
                                                                    <div class="col-sm-10">
                                                                        <div class="card">
                                                                            <div class="card-body">
                                                                                <p></p>
                                                                                <textarea name="<%= entry.fields_value %>" id="<%= entry.fields_value %>" class="tinymce-editor">
                                                                                    <%= entry.page_meta_value %>
                                                                                </textarea><!-- End TinyMCE Editor -->
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
