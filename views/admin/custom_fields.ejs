<%- include('header') %>
    <main id="main" class="main">

        <div class="pagetitle">
            <h1>Custom Fields</h1>
            <nav>
                <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Home</a></li>
                <li class="breadcrumb-item">Custom Fields</li>
                </ol>
            </nav>
        </div><!-- End Page Title -->

        <section class="section">
            <div class="row">
                <div class="col-lg-10">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Add New Field Group</h5>

                            <!-- General Form Elements -->
                            <form action="../save_field_groups" method="post" class="row g-3 needs-validation" novalidate>

                                <div class="row mb-3">
                                    <label for="inputText" class="col-sm-2 col-form-label">Field Group Name</label>
                                    <div class="col-sm-10">
                                        <input type="text" name="field_groups_name" class="form-control" required>
                                        <div class="invalid-feedback">
                                            Please Enter a Field Group Name.
                                        </div>
                                    </div>
                                </div>

                                <% if(pages_list){ %>
                                    <div class="row mb-3">
                                        <label class="col-sm-2 col-form-label">Field Page</label>
                                        <div class="col-sm-10">
                                            <select name="page_id" class="form-select" aria-label="Default select example" required>
                                                <% pages_list.forEach(entry => { %>
                                                    <option value="<%= entry.page_id %>"><%= entry.page_name %></option>
                                                <% }) %>
                                            </select>
                                            <div class="invalid-feedback">
                                                Please Enter a Field Name.
                                            </div>
                                        </div>
                                    </div>
                                <% } %>

                                <div class="row mb-3">
                                    <div class="col-sm-10">
                                        <button type="submit" class="btn btn-primary"> <i class="bi bi-plus-lg"></i> Add Field Group </button>
                                    </div>
                                </div>

                            </form><!-- End General Form Elements -->

                        </div>
                    </div>

                </div>

                <div class="col-lg-10">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Field Groups List</h5>
                            <% var i=1 %>
                            <% if(field_groups_list){ %>
                                <!-- Table with hoverable rows -->
                                <table class="table table-hover">
                                    <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Field Groups Name</th>
                                        <th scope="col">Page Name</th>
                                        <th class="text-center" scope="col" colspan="3">Action</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                        <% field_groups_list.forEach(entry => { %>
                                            <tr>
                                                <th class="col-1" scope="row"><%= i %></th>
                                                <td class="col-4"><%= entry.field_groups_name %></td>
                                                <td class="col-4"><%= entry.page_name %></td>
                                                <td class="col-1"><a href="/admin/field_groups_edit/<%= entry.field_groups_id %>">Edit</a></td>
                                                <td class="col-1"><a href="/admin/field_groups_update/<%= entry.field_groups_id %>">Update</a></td>
                                                <td class="col-1"><a href="/admin/field_groups_delete/<%= entry.field_groups_id %>">Delete</a></td>
                                            </tr>
                                            <% i++ %>
                                        <% }) %>
                                    </tbody>
                                </table>
                                <!-- End Table with hoverable rows -->
                            <% } else { %>
                                <h6>Field Groups not found</h6>
                            <% } %>
            
                        </div>
                    </div>
            
                </div>

            </div>
        </section>

    </main><!-- End #main -->

<%- include('footer') %>