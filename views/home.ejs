<%- include('header') %>
    <% if(pageMetaList){ %>
        <!-- Hero Start -->
        <% if(pageMetaList.Banner_background_image){ %>
            <div class="container-fluid bg-primary py-5 mb-5 hero-header" style="background: url(http://127.0.0.1:3000/upload/<%= pageMetaList.Banner_background_image %>) top right no-repeat;background-size: cover;">
        <% } else { %>
            <div class="container-fluid bg-primary py-5 mb-5 hero-header">
        <% } %>
            <div class="container py-5">
                <div class="row justify-content-start">
                    <div class="col-lg-8 text-center text-lg-start">
                        <% if(pageMetaList.home_page_title_1){ %>
                            <h1 class="font-secondary text-primary mb-4"><%= pageMetaList.home_page_title_1 %></h1>
                        <% } %>
                        <% if(pageMetaList.home_page_title_2){ %>
                            <h1 class="display-1 text-uppercase text-white mb-4"><%= pageMetaList.home_page_title_2 %></h1>
                        <% } %>
                        <% if(pageMetaList.home_page_title_3){ %>
                            <h1 class="text-uppercase text-white"><%= pageMetaList.home_page_title_3 %></h1>
                        <% } %>
                        <div class="d-flex align-items-center justify-content-center justify-content-lg-start pt-5">
                            <% if(pageMetaList.banner_button_link){ %>
                                <a href="<%= pageMetaList.banner_button_link %>" class="btn btn-primary border-inner py-3 px-5 me-5"><%= pageMetaList.banner_button_text %></a>
                            <% } %>
                            <% if(pageMetaList.video_link){ %>
                                <button type="button" class="btn-play" data-bs-toggle="modal" data-src="<%= pageMetaList.video_link %>" data-bs-target="#videoModal"><span></span></button>
                                <h5 class="font-weight-normal text-white m-0 ms-4 d-none d-sm-block"><%= pageMetaList.video_text %></h5>
                            <% } %> 
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Hero End -->

        <!-- Video Modal Start -->
        <div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content rounded-0">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Youtube Video</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <!-- 16:9 aspect ratio -->
                        <div class="ratio ratio-16x9">
                            <iframe class="embed-responsive-item" src="" id="video" allowfullscreen allowscriptaccess="always"
                                allow="autoplay"></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Video Modal End -->


        <!-- About Start -->
        <div class="container-fluid pt-5">
            <div class="container">
                <div class="section-title position-relative text-center mx-auto mb-5 pb-3" style="max-width: 600px;">
                    <% if(pageMetaList.about_title){ %>
                        <h2 class="text-primary font-secondary"><%= pageMetaList.about_title %></h2>
                    <% } %>
                    <% if(pageMetaList.about_title_2){ %>
                        <h1 class="display-4 text-uppercase"><%= pageMetaList.about_title_2 %></h1>
                    <% } %>
                </div>
                <div class="row gx-5">
                    <% if(pageMetaList.about_image){ %>
                        <div class="col-lg-5 mb-5 mb-lg-0" style="min-height: 400px;">
                            <div class="position-relative h-100">
                                <img class="position-absolute w-100 h-100" src="http://127.0.0.1:3000/upload/<%= pageMetaList.about_image %>" style="object-fit: cover;">
                            </div>
                        </div>
                    <% } %>
                    <div class="col-lg-6 pb-5">
                        <% if(pageMetaList.about_content){ %>
                            <%- pageMetaList.about_content %>
                        <% } %>
                        <div class="row g-5">
                            <% if(pageMetaList.about_repeater){ %>
                                <% for(var i = 0; i < pageMetaList.about_repeater; i++){ %>
                                    <% var title = JSON.parse(repeaterFieldList.about_repeater.title) %>
                                    <% var content = JSON.parse(repeaterFieldList.about_repeater.content) %>
                                    <% var icon = JSON.parse(repeaterFieldList.about_repeater.icon) %>
                                    <div class="col-sm-6">
                                        <div class="d-flex align-items-center justify-content-center bg-primary border-inner mb-4" style="width: 90px; height: 90px;">
                                            <% icon.forEach(tmp => { %>
                                                <%- tmp[i] %>
                                            <% }) %>
                                        </div>
                                        <h4 class="text-uppercase">
                                            <% title.forEach(tmp => { %>
                                                <%= tmp[i] %>
                                            <% }) %>
                                        </h4>
                                        <p class="mb-0">
                                            <% content.forEach(tmp => { %>
                                                <%- tmp[i] %>
                                            <% }) %>
                                        </p>
                                    </div>
                                <% } %>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- About End -->


        <!-- Facts Start -->
        <div class="container-fluid bg-img py-5 mb-5">
            <div class="container py-5">
                <div class="row gx-5 gy-4">
                    <% if(pageMetaList.counter_section){ %>
                        <% for(var i = 0; i < pageMetaList.counter_section; i++){ %>
                            <% var counter_title = JSON.parse(repeaterFieldList.counter_section.counter_title) %>
                            <% var counter_number = JSON.parse(repeaterFieldList.counter_section.counter_number) %>
                            <% var counter_icon = JSON.parse(repeaterFieldList.counter_section.counter_icon) %>
                            <div class="col-lg-3 col-md-6">
                                <div class="d-flex">
                                    <div class="bg-primary border-inner d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                        <% counter_icon.forEach(tmp => { %>
                                            <%- tmp[i] %>
                                        <% }) %>
                                    </div>
                                    <div class="ps-4">
                                        <h6 class="text-primary text-uppercase">
                                            <% counter_title.forEach(tmp => { %>
                                                <%- tmp[i] %>
                                            <% }) %>
                                        </h6>
                                        <h1 class="display-5 text-white mb-0" data-toggle="counter-up">
                                            <% counter_number.forEach(tmp => { %>
                                                <%- tmp[i] %>
                                            <% }) %>
                                        </h1>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </div>
        <!-- Facts End -->


