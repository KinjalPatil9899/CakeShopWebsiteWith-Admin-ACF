<%- include('header') %>
    <main id="main" class="main">

        <div class="pagetitle">
            <h1><%= field_groups_name %></h1>
            <nav>
                <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Home</a></li>
                <li class="breadcrumb-item"><a href="/admin/custom_fields">Custom Fields</a></li>
                <li class="breadcrumb-item">Add New Field</li>
                </ol>
            </nav>
        </div><!-- End Page Title -->

        <section class="section">
            <div class="row">
                <div class="col-lg-10">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Add New Field</h5>

                            <!-- General Form Elements -->
                            <form action="../save_field" method="post" class="row g-3 needs-validation" novalidate>
                                <% if(field_type_list){ %>
                                    <div class="row mb-3">
                                        <label class="col-sm-2 col-form-label">Field Type</label>
                                        <div class="col-sm-10">
                                            <select class="form-select" id="field_type_id" name="field_type_id" class="form-select" aria-label="Default select example" required onchange="myFunction()">
                                                <% field_type_list.forEach(entry => { %>
                                                    <option value="<%= entry.field_type_id %>"><%= entry.field_type_value %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    </div>
                                <% } %>

                                <% if(fields_list){ %>
                                    <div class="row mb-3" id="tab_id_div">
                                        <label class="col-sm-2 col-form-label">Tab Name</label>
                                        <div class="col-sm-10">
                                            <select class="form-select" id="field_tab_id" name="field_tab_id" class="form-select" aria-label="Default select example" required onchange="myFunction()">
                                                <option value="0">Please Select Tab</option>
                                                <% fields_list.forEach(entry => { %>
                                                    <% if(entry.field_type_id == "9"){ %>
                                                        <option value="<%= entry.fields_id %>"><%= entry.fields_name %></option>
                                                    <% } %>
                                                <% }) %>
                                            </select>
                                        </div>
                                    </div>
                                <% } %>

                                <div class="row mb-3">
                                    <label for="inputText" class="col-sm-2 col-form-label">Field Label</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="field_label" name="field_label" class="form-control" required>
                                        <div class="invalid-feedback">
                                            Please Enter a Field Label.
                                        </div>
                                        <% if(error_message != ""){ %>
                                            <div class="alert alert-warning alert-dismissible fade show mt-3 mb-0" role="alert">
                                                <%= error_message %>
                                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                                
                                <div class="row mb-3">
                                    <label for="inputText" class="col-sm-2 col-form-label">Field Name</label>
                                    <div class="col-sm-10">
                                        <input type="text" id="field_name" name="field_name" class="form-control" required onfocusin="myTextlowercase()">
                                        <div class="invalid-feedback">
                                            Please Enter a Field Name.
                                        </div>
                                        <% if(error_message != ""){ %>
                                            <div class="alert alert-warning alert-dismissible fade show mt-3 mb-0" role="alert">
                                                <%= error_message %>
                                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="row mb-3" id="customRepeater" style="display: none;">
                                    <label for="inputText" class="col-sm-2 col-form-label">Number of Sub Field</label>
                                    <div class="col-sm-10">
                                        <input type="number" name="field_sub_count" class="form-control" value="0">
                                    </div>
                                </div>

                                <input type="hidden" name="field_groups_id" value="<%= field_groups_id %>">

                                <div class="row mb-3">
                                    <div class="col-sm-10">
                                        <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Field</button>
                                    </div>
                                </div>

                            </form>
                            <!-- End General Form Elements -->

                        </div>
                    </div>

                </div>

                <div class="col-lg-10">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Fields List</h5>
                            <% var i=1 %>
                            <% if(fields_list){ %>
                                <!-- Table with hoverable rows -->
                                <table class="table table-hover">
                                    <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Field Type</th>
                                        <th scope="col">Field Label</th>
                                        <th scope="col">Fields Name</th>
                                        <th class="text-center" scope="col" colspan="3">Action</th>
                                    </tr>
                                    </thead>
                                    <tbody class="column"> 
                                        <% fields_list.forEach(entry => { %>
                                            <tr class="item" draggable="true" data-title="<%= i %>">
                                                <th class="col-1" scope="row"><%= i %></th>
                                                <% if(field_type_list){ %>
                                                    <% field_type_list.forEach(field_type => { %>
                                                        <% if(field_type.field_type_id == entry.field_type_id){ %>
                                                            <td class="col-3"><%= field_type.field_type_value %></td>
                                                        <% } %>
                                                    <% }) %>
                                                <% } %>
                                                <td class="col-3"><%= entry.fields_name %></td>
                                                <td class="col-3"><%= entry.fields_value %></td>
                                                <td class="col-1"><a href="/admin/field_edit/<%= entry.fields_id %>">Edit</a></td>
                                                <td class="col-1"><a href="/admin/field_delete/<%= entry.fields_id %>">Delete</a></td>
                                            </tr>
                                            <% i++ %>
                                        <% }) %>
                                    </tbody>
                                </table>
                                <!-- End Table with hoverable rows -->
                            <% } else { %>
                                <h6>Fields not found</h6>
                            <% } %>
            
                        </div>
                    </div>
            
                </div>

            </div>
        </section>

    </main><!-- End #main -->

<%- include('footer') %>