<%- include('header') %>
    <main id="main" class="main">

        <div class="pagetitle">
            <h1>Users</h1>
            <nav>
                <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/">Home</a></li>
                <li class="breadcrumb-item active">Users</li>
                </ol>
            </nav>
        </div><!-- End User Title -->

        <section class="section">
            <div class="row">
                <div class="col-lg-10">
                    <div class="card">
                        <div class="card-body">
                        <h5 class="card-title">Edit User</h5>
                        <% if(error_message) { %>
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                              <%= error_message %>
                              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                          <% } %>

                          <% if(userinfo){ %>
                            <% userinfo.forEach(entry => { %>

                                <form class="row g-3 needs-validation" method="post" action="/admin/save_update_user/<%= entry.user_id %>" novalidate>
                                    <div class="row mb-3">
                                        <div class="col-12">
                                            <label for="yourName" class="form-label">User Name</label>
                                            <input type="text" name="name" class="form-control" id="yourName" required value="<%= entry.username %>">
                                            <div class="invalid-feedback">Please, enter your name!</div>
                                        </div>
                    
                                        <div class="col-12">
                                            <label for="yourEmail" class="form-label">User Email</label>
                                            <input type="email" name="email" class="form-control" id="yourEmail" required value="<%= entry.user_email %>">
                                            <div class="invalid-feedback">Please enter a valid Email adddress!</div>
                                        </div>

                                        <div class="col-12">
                                            <label class="col-sm-2 col-form-label">User Role</label>
                                            <select class="form-select" id="user_role" name="user_role" class="form-select" aria-label="Default select example" required onchange="myFunction()">
                                                <% if(entry.user_role == 'Editor'){ %>
                                                    <option selected value="Editor">Editor</option>
                                                <% } else { %>
                                                    <option value="Editor">Editor</option>
                                                <% } %>
                                                <% if(entry.user_role == 'Administrator'){ %>
                                                    <option selected value="Administrator">Administrator</option>
                                                <% } else { %>
                                                    <option value="Administrator">Administrator</option>
                                                <% } %>
                                            </select>
                                        </div>
                    
                                        <div class="col-12">
                                            <label for="yourUsername" class="form-label">Username</label>
                                            <div class="input-group has-validation">
                                                <span class="input-group-text" id="inputGroupPrepend">@</span>
                                                <input type="text" name="username" class="form-control" id="yourUsername" required value="<%= entry.username %>">
                                                <div class="invalid-feedback">Please choose a username.</div>
                                            </div>
                                        </div>
                
                                        <div class="col-12">
                                            <label for="yourPassword" class="form-label">Password</label>
                                            <input type="password" name="password" class="form-control" id="yourPassword">
                                            <div class="invalid-feedback">Please enter your password!</div>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-sm-10">
                                            <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add User</button>
                                        </div>
                                    </div>
                                </form>
                            <% }) %>
                        <% } else { %>
                            <h6>Users not found</h6>
                        <% } %>
                        </div>
                    </div>

                </div>
            </div>
        </section>

    </main><!-- End #main -->

<%- include('footer') %>