<%- include('header') %>

<main id="main" class="main">

    <div class="pagetitle">
      <h1>Edit Page</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/admin/">Home</a></li>
          <li class="breadcrumb-item"><a href="/admin/pages">Pages</a></li>
          <li class="breadcrumb-item active">Edit Page</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Edit <%= pageName %></h5>
                        <!-- General Form Elements -->

                        <% if(fields_list){ %>
                            <form action="../page_update/<%= pageId %>" method="post" enctype="multipart/form-data">
                                <ul class="nav nav-pills custom_nav" id="myTab" role="tablist">
                                    <% var i=1; %>
                                    <% fields_list.forEach(entry => { %>
                                        <% if(entry.field_type_name == "tab"){ %>
                                            <li class="nav-item" role="presentation">
                                                <% if(i == "1"){ %>
                                                    <button class="nav-link active" id="<%= entry.fields_value %>-tab" data-bs-toggle="tab" data-bs-target="#<%= entry.fields_value %>" type="button" role="tab" aria-controls="<%= entry.fields_value %>" aria-selected="true"><%= entry.fields_name %></button>
                                                <% } else { %>
                                                    <button class="nav-link" id="<%= entry.fields_value %>-tab" data-bs-toggle="tab" data-bs-target="#<%= entry.fields_value %>" type="button" role="tab" aria-controls="<%= entry.fields_value %>" aria-selected="true"><%= entry.fields_name %></button>
                                                <% } %>
                                            </li>
                                            <% i++; %>
                                        <% } %>
                                    <% }) %>
                                </ul>
                                <% var j=1; %>
                                <div class="tab-content pt-2 custom_content" id="myTabContent">
                                    <% fields_list.forEach(tab => { %>
                                        <% if(tab.field_type_name == "tab"){ %>
                                            <% if(j == "1"){ %>
                                                <div class="tab-pane fade show active" id="<%= tab.fields_value %>" role="tabpanel" aria-labelledby="<%= tab.fields_value %>-tab">
                                                    <% fields_list.forEach(entry => { %>
                                                        <% if(tab.fields_id == entry.field_tab_id){ %>
                                                            <% if(entry.field_type_name == "text"){ %>
                                                                <div class="row mb-3">
                                                                    <label for="inputText" class="col-sm-2 col-form-label"><%= entry.fields_name %></label>
                                                                    <div class="col-sm-10">
                                                                        <input type="text" name="<%= entry.fields_value %>" class="form-control" value="<%= entry.page_meta_value %>">
                                                                    </div>
                                                                </div>
                                                            <% } else if(entry.field_type_name == "textarea"){ %>
                                                                <div class="row mb-3">
                                                                    <label for="inputTextarea" class="col-sm-2 col-form-label"><%= entry.fields_name %></label>
                                                                    <div class="col-sm-10">
                                                                        <textarea name="<%= entry.fields_value %>" class="form-control" style="height: 100px">
                                                                            <%= entry.page_meta_value %>
                                                                        </textarea>
                                                                    </div>
                                                                </div>
                                                            <% } else if(entry.field_type_name == "image") { %>
                                                                <div class="row mb-3">
                                                                    <label for="inputFile" class="col-sm-2 col-form-label"><%= entry.fields_name %></label>
                                                                    <div class="col-sm-10">
                                                                        <input type="file" accept="image/png, image/gif, image/jpeg" name="<%= entry.fields_value %>" class="form-control">
                                                                        <% if(entry.page_meta_value != ""){ %>
                                                                            <div class="row g-0 mt-3">
                                                                                <div class="col-md-4">
                                                                                <img src="http://127.0.0.1:3000/upload/<%= entry.page_meta_value %>" class="img-fluid rounded" alt="...">
                                                                                </div>
                                                                            </div>
                                                                        <% } %>
                                                                    </div>
                                                                </div>
                                                            <% } else if(entry.field_type_name == "wysiwyg") { %>
