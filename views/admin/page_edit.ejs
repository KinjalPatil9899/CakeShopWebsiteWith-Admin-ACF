<%- include('header') %>

<main id="main" class="main">

    <div class="pagetitle">
      <h1>Edit Page</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="index.html">Home</a></li>
          <li class="breadcrumb-item">Pages</li>
          <li class="breadcrumb-item active">Edit Page</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Edit <%= pageName %></h5>
                        <!-- General Form Elements -->
                        <% if(fields_list){ %>
                            <form action="../page_save/<%= pageId %>" method="post">
                                <% fields_list.forEach(entry => { %>
                                    <% if(entry.field_type_name == "text"){ %>
                                        <div class="row mb-3">
                                            <label for="inputText" class="col-sm-2 col-form-label"><%= entry.fields_name %></label>
                                            <div class="col-sm-10">
                                                <input type="text" name="<%= entry.fields_value %>" class="form-control" value="<%= entry.page_meta_value %>">
                                            </div>
                                        </div>
                                    <% } else if(entry.field_type_name == "textarea"){ %>
                                        <div class="row mb-3">
                                            <label for="inputTextarea" class="col-sm-2 col-form-label"><%= entry.fields_name %></label>
                                            <div class="col-sm-10">
                                                <textarea name="<%= entry.fields_value %>" class="form-control" style="height: 100px"></textarea>
                                            </div>
                                        </div>
                                    <% } else if(entry.field_type_name == "image") { %>
                                        <div class="row mb-3">
                                            <label for="inputFile" class="col-sm-2 col-form-label"><%= entry.fields_name %></label>
                                            <div class="col-sm-10">
                                                <input type="file" name="<%= entry.fields_value %>" class="form-control" s="<%= entry.fields_value %>">
                                            </div>
                                        </div>
                                    <% } else if(entry.field_type_name == "wysiwyg") { %>
                                        <div class="row mb-3">
                                            <label for="inputWysiwyg" class="col-sm-2 col-form-label"><%= entry.fields_name %></label>
                                            <div class="col-sm-10">
                                                <div name="<%= entry.fields_value %>" class="quill-editor-full">
                                                </div>
                                            </div>
                                        </div>
                                    <%} else if(entry.field_type_name == "date_picker") { %>
                                        <div class="row mb-3">
                                            <label for="inputDate" class="col-sm-2 col-form-label"><%= entry.fields_name %></label>
                                            <div class="col-sm-10">
                                                <input type="date" name="<%= entry.fields_value %>" class="form-control">
                                            </div>
                                        </div>
                                    <%} else if(entry.field_type_name == "time_picker") { %>
                                        <div class="row mb-3">
                                            <label for="inputTime" class="col-sm-2 col-form-label"><%= entry.fields_name %></label>
                                            <div class="col-sm-10">
                                                <input type="time" name="<%= entry.fields_value %>" class="form-control">
                                            </div>
                                        </div>
                                    <%} else if(entry.field_type_name == "date_time_picker") { %>
                                        <div class="row mb-3">
                                            <label for="inputTime" class="col-sm-2 col-form-label"><%= entry.fields_name %></label>
                                            <div class="col-sm-10">
                                                <input type="datetime-local" name="<%= entry.fields_value %>" class="form-control">
                                            </div>
                                        </div>
                                    <% } %>
                                <% }) %>
                                <div class="row mb-3">
                                    <div class="col-sm-10">
                                        <button type="submit" class="btn btn-primary">Save</button>
                                    </div>
                                </div>
                            </form><!-- End General Form Elements -->
                        <% } else { %>
                            <h6>Please add Some Field From Custom Fields.</h6>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>

  </main><!-- End #main -->

<%- include('footer') %>